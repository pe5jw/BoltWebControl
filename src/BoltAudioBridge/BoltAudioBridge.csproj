<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BoltAudioBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WebRTC + SIP/RTP stack -->
    <PackageReference Include="SIPSorcery" Version="6.*" />
    <!-- SIPSorcery media abstractions (IAudioSource, IAudioSink, AudioEncoder) -->
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="1.*" />
    <!-- Audio I/O: miniaudio bindings voor Win + Linux, geen externe deps -->
    <PackageReference Include="Hexa.NET.MiniAudio" Version="*" />
  </ItemGroup>
</Project>
