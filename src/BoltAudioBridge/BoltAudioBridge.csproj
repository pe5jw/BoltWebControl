<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BoltAudioBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WebRTC server-side peer -->
    <PackageReference Include="SIPSorcery" Version="6.*" />
    <!-- Audio I/O: miniaudio bindings voor Win/Linux/macOS -->
    <PackageReference Include="Hexa.NET.MiniAudio" Version="*" />
    <!-- SignalR voor WebRTC signaling -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="*" />
  </ItemGroup>
</Project>
